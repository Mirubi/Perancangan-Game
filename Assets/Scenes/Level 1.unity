      value: 
      objectReference: {fileID: 318731453}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogueManager
      value: 
      objectReference: {fileID: 1947343944}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.size
      value: 14
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[0].dialog
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[1].dialog
      value: "Ehh, Kang Bima\u2026 Anjeun rek ka leuweung sorangan, Kang?"
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[2].dialog
      value: Teu sieun ku jurig leuweung kitu?
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[3].dialog
      value: Aya keperluan naon kitu, Kang?
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[4].dialog
      value: Simkuring bade milari Gung sisihung angin, parentah ti guru Dorna ker
        syarat neang Tirta Pawitra.
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[5].dialog
      value: Sugan kuring maneh keur milari sambel...
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[6].dialog
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[7].dialog
      value: "Eh miliari gung sisihung angin\u2026 naon deui etateh? kayu nu bisa
        nyeuseup angin?"
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[8].dialog
      value: Ah, nu penting mah ulah salah mawa. Mun salah, bisa-bisa balik bawa
        kayu bakar keur dipake siduru!
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[9].dialog
      value: Rek kayu nanaon ge teu penting, nu penting mah niat dina ngalaksanakeun
        eta parentah!
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[10].dialog
      value: Leweung ieu pinuh ku mahluk-mahluk leuweung, tapi oge pinuh ku ujian
        batin.
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[11].dialog
      value: 'Lamun goreng hate, bisa bisa nyasab. '
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[12].dialog
      value: Muhun dulur-dulur, tapi sagalana bakal kuring sorang, sanajan leuweung
        pinuh ku marabahaya, sanajan jalan pinuh ku cobaan. Mugi Gusti nu Maha Kawasa
        ngiringan dina unggal lengkah.
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[13].dialog
      value: Simkuring angkat ayeuna.
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[0].speakerID
      value: Bima
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[1].speakerID
      value: Cepot
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[2].speakerID
      value: Cepot
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[3].speakerID
      value: Cepot
      objectReference: {fileID: 0}
    - target: {fileID: 133917424242222203, guid: f12e7375853c55744929b6c4a5f45ab3, type: 3}
      propertyPath: dialogs.Array.data[4].speakerID
